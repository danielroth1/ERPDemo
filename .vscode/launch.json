{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "k8sNamespace",
      "type": "promptString",
      "description": "Kubernetes namespace",
      "default": "erp-local"
    },
    {
      "id": "k8sPodGateway",
      "type": "promptString",
      "description": "Pod name for gateway (kubectl -n erp-local get pods -l app=gateway)",
      "default": "gateway-"
    },
    {
      "id": "k8sPodUserManagement",
      "type": "promptString",
      "description": "Pod name for user-management (kubectl -n erp-local get pods -l app=user-management)",
      "default": "user-management-"
    },
    {
      "id": "k8sPodInventory",
      "type": "promptString",
      "description": "Pod name for inventory (kubectl -n erp-local get pods -l app=inventory)",
      "default": "inventory-"
    },
    {
      "id": "k8sPodSales",
      "type": "promptString",
      "description": "Pod name for sales (kubectl -n erp-local get pods -l app=sales)",
      "default": "sales-"
    },
    {
      "id": "k8sPodFinancial",
      "type": "promptString",
      "description": "Pod name for financial (kubectl -n erp-local get pods -l app=financial)",
      "default": "financial-"
    },
    {
      "id": "k8sPodDashboard",
      "type": "promptString",
      "description": "Pod name for dashboard (kubectl -n erp-local get pods -l app=dashboard)",
      "default": "dashboard-"
    }
  ],
  "configurations": [
    {
      "name": "Launch API Gateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-gateway",
      "program": "${workspaceFolder}/services/gateway/ApiGateway/bin/Debug/net8.0/ApiGateway.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/gateway/ApiGateway",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8080"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch User Management",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-user-management",
      "program": "${workspaceFolder}/services/user-management/UserManagement/bin/Debug/net8.0/UserManagement.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/user-management/UserManagement",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5001"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Inventory Management",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-inventory",
      "program": "${workspaceFolder}/services/inventory/InventoryManagement/bin/Debug/net8.0/InventoryManagement.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/inventory/InventoryManagement",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5002"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Sales & Orders",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-sales-orders",
      "program": "${workspaceFolder}/services/sales-orders/SalesOrders/bin/Debug/net8.0/SalesOrders.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/sales-orders/SalesOrders",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5003"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Financial Management",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-financial",
      "program": "${workspaceFolder}/services/financial/FinancialManagement/bin/Debug/net8.0/FinancialManagement.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/financial/FinancialManagement",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5004"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Dashboard & Analytics",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-dashboard",
      "program": "${workspaceFolder}/services/dashboard/DashboardAnalytics/bin/Debug/net8.0/DashboardAnalytics.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/dashboard/DashboardAnalytics",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5005"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Attach to API Gateway",
      "type": "coreclr",
      "request": "attach",
      "processName": "ApiGateway"
    },
    {
      "name": "Attach to User Management",
      "type": "coreclr",
      "request": "attach",
      "processName": "UserManagement"
    },
    {
      "name": "Attach to Inventory Management",
      "type": "coreclr",
      "request": "attach",
      "processName": "InventoryManagement"
    },
    {
      "name": "Attach to Sales & Orders",
      "type": "coreclr",
      "request": "attach",
      "processName": "SalesOrders"
    },
    {
      "name": "Attach to Financial Management",
      "type": "coreclr",
      "request": "attach",
      "processName": "FinancialManagement"
    },
    {
      "name": "Attach to Dashboard & Analytics",
      "type": "coreclr",
      "request": "attach",
      "processName": "DashboardAnalytics"
    },
    {
      "name": "Attach (K8s) API Gateway",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "kubectl",
        "pipeArgs": [
          "exec",
          "-i",
          "-n",
          "${input:k8sNamespace}",
          "${input:k8sPodGateway}",
          "--"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/ApiGateway": "${workspaceFolder}/services/gateway/ApiGateway"
      }
    },
    {
      "name": "Attach (K8s) User Management",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "kubectl",
        "pipeArgs": [
          "exec",
          "-i",
          "-n",
          "${input:k8sNamespace}",
          "${input:k8sPodUserManagement}",
          "--"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/UserManagement": "${workspaceFolder}/services/user-management/UserManagement"
      }
    },
    {
      "name": "Attach (K8s) Inventory",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "kubectl",
        "pipeArgs": [
          "exec",
          "-i",
          "-n",
          "${input:k8sNamespace}",
          "${input:k8sPodInventory}",
          "--"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/InventoryManagement": "${workspaceFolder}/services/inventory/InventoryManagement"
      }
    },
    {
      "name": "Attach (K8s) Sales",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "kubectl",
        "pipeArgs": [
          "exec",
          "-i",
          "-n",
          "${input:k8sNamespace}",
          "${input:k8sPodSales}",
          "--"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/SalesManagement": "${workspaceFolder}/services/sales/SalesManagement"
      }
    },
    {
      "name": "Attach (K8s) Financial",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "kubectl",
        "pipeArgs": [
          "exec",
          "-i",
          "-n",
          "${input:k8sNamespace}",
          "${input:k8sPodFinancial}",
          "--"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/FinancialManagement": "${workspaceFolder}/services/financial/FinancialManagement"
      }
    },
    {
      "name": "Attach (K8s) Dashboard",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "kubectl",
        "pipeArgs": [
          "exec",
          "-i",
          "-n",
          "${input:k8sNamespace}",
          "${input:k8sPodDashboard}",
          "--"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/DashboardAnalytics": "${workspaceFolder}/services/dashboard/DashboardAnalytics"
      }
    },
    {
      "name": "Attach (K8s Auto) API Gateway",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "powershell",
        "pipeArgs": [
          "-NoProfile",
          "-Command",
          "kubectl exec -i -n ${input:k8sNamespace} $(kubectl -n ${input:k8sNamespace} get pods -l app=gateway -o jsonpath='{.items[0].metadata.name}') -c gateway --"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/ApiGateway": "${workspaceFolder}/services/gateway/ApiGateway"
      }
    },
    {
      "name": "Attach (K8s Auto) User Management",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "powershell",
        "pipeArgs": [
          "-NoProfile",
          "-Command",
          "kubectl exec -i -n ${input:k8sNamespace} $(kubectl -n ${input:k8sNamespace} get pods -l app=user-management -o jsonpath='{.items[0].metadata.name}') -c user-management --"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/UserManagement": "${workspaceFolder}/services/user-management/UserManagement"
      }
    },
    {
      "name": "Attach (K8s Auto) Inventory",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "powershell",
        "pipeArgs": [
          "-NoProfile",
          "-Command",
          "kubectl exec -i -n ${input:k8sNamespace} $(kubectl -n ${input:k8sNamespace} get pods -l app=inventory -o jsonpath='{.items[0].metadata.name}') -c inventory --"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/InventoryManagement": "${workspaceFolder}/services/inventory/InventoryManagement"
      }
    },
    {
      "name": "Attach (K8s Auto) Sales",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "powershell",
        "pipeArgs": [
          "-NoProfile",
          "-Command",
          "kubectl exec -i -n ${input:k8sNamespace} $(kubectl -n ${input:k8sNamespace} get pods -l app=sales -o jsonpath='{.items[0].metadata.name}') -c sales --"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/SalesManagement": "${workspaceFolder}/services/sales/SalesManagement"
      }
    },
    {
      "name": "Attach (K8s Auto) Financial",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "powershell",
        "pipeArgs": [
          "-NoProfile",
          "-Command",
          "kubectl exec -i -n ${input:k8sNamespace} $(kubectl -n ${input:k8sNamespace} get pods -l app=financial -o jsonpath='{.items[0].metadata.name}') -c financial --"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/FinancialManagement": "${workspaceFolder}/services/financial/FinancialManagement"
      }
    },
    {
      "name": "Attach (K8s Auto) Dashboard",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "powershell",
        "pipeArgs": [
          "-NoProfile",
          "-Command",
          "kubectl exec -i -n ${input:k8sNamespace} $(kubectl -n ${input:k8sNamespace} get pods -l app=dashboard -o jsonpath='{.items[0].metadata.name}') -c dashboard --"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/DashboardAnalytics": "${workspaceFolder}/services/dashboard/DashboardAnalytics"
      }
    },
    {
      "name": "Launch Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "dev-frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Launch Frontend (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "dev-frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Launch Frontend (Firefox)",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "dev-frontend",
      "pathMappings": [
        {
          "url": "http://localhost:5173",
          "path": "${workspaceFolder}/frontend"
        }
      ]
    },
    {
      "name": "Attach to Frontend (Chrome)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Attach to Frontend (Edge)",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Attach to Frontend (Firefox)",
      "type": "firefox",
      "request": "attach",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "pathMappings": [
        {
          "url": "http://localhost:5173",
          "path": "${workspaceFolder}/frontend"
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "Launch All Backend Services",
      "configurations": [
        "Launch API Gateway",
        "Launch User Management",
        "Launch Inventory Management",
        "Launch Sales & Orders",
        "Launch Financial Management",
        "Launch Dashboard & Analytics"
      ],
      "presentation": {
        "hidden": false,
        "group": "all",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "Attach to All Services",
      "configurations": [
        "Attach to API Gateway",
        "Attach to User Management",
        "Attach to Inventory Management",
        "Attach to Sales & Orders",
        "Attach to Financial Management",
        "Attach to Dashboard & Analytics"
      ],
      "presentation": {
        "hidden": false,
        "group": "attach",
        "order": 1
      }
    },
    {
      "name": "Launch Full Stack (Chrome)",
      "configurations": [
        "Launch API Gateway",
        "Launch User Management",
        "Launch Inventory Management",
        "Launch Sales & Orders",
        "Launch Financial Management",
        "Launch Dashboard & Analytics",
        "Launch Frontend (Chrome)"
      ],
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "Launch Full Stack (Edge)",
      "configurations": [
        "Launch API Gateway",
        "Launch User Management",
        "Launch Inventory Management",
        "Launch Sales & Orders",
        "Launch Financial Management",
        "Launch Dashboard & Analytics",
        "Launch Frontend (Edge)"
      ],
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 2
      },
      "stopAll": true
    },
    {
      "name": "Launch Full Stack (Firefox)",
      "configurations": [
        "Launch API Gateway",
        "Launch User Management",
        "Launch Inventory Management",
        "Launch Sales & Orders",
        "Launch Financial Management",
        "Launch Dashboard & Analytics",
        "Launch Frontend (Firefox)"
      ],
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 3
      },
      "stopAll": true
    }
  ]
}
