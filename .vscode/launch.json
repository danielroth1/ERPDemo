{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "k8sNamespace",
      "type": "promptString",
      "description": "Kubernetes namespace",
      "default": "erp-local"
    },
    {
      "id": "k8sPodName",
      "type": "promptString",
      "description": "Pod name (run task 'k8s: get-pod-name' to copy to clipboard)",
      "default": "gateway-"
    }
  ],
  "configurations": [
    // ============================================================
    // BACKEND LAUNCH CONFIGURATIONS
    // ============================================================
    {
      "name": "Backend: Launch Gateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build-gateway",
      "program": "${workspaceFolder}/services/gateway/ApiGateway/bin/Debug/net8.0/ApiGateway.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/gateway/ApiGateway",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8080"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    },
    {
      "name": "Backend: Launch User Management",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build-user-management",
      "program": "${workspaceFolder}/services/user-management/UserManagement/bin/Debug/net8.0/UserManagement.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/user-management/UserManagement",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5001"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    },
    {
      "name": "Backend: Launch Inventory",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build-inventory",
      "program": "${workspaceFolder}/services/inventory/InventoryManagement/bin/Debug/net8.0/InventoryManagement.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/inventory/InventoryManagement",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5002"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    },
    {
      "name": "Backend: Launch Sales",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build-sales",
      "program": "${workspaceFolder}/services/sales/SalesManagement/bin/Debug/net8.0/SalesManagement.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/sales/SalesManagement",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5003"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    },
    {
      "name": "Backend: Launch Financial",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build-financial",
      "program": "${workspaceFolder}/services/financial/FinancialManagement/bin/Debug/net8.0/FinancialManagement.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/financial/FinancialManagement",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5004"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    },
    {
      "name": "Backend: Launch Dashboard",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build-dashboard",
      "program": "${workspaceFolder}/services/dashboard/DashboardAnalytics/bin/Debug/net8.0/DashboardAnalytics.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/dashboard/DashboardAnalytics",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5005"
      },
      "sourceFileMap": { "/Views": "${workspaceFolder}/Views" }
    },
    {
      "name": "Backend: Attach to Gateway",
      "type": "coreclr",
      "request": "attach",
      "processName": "ApiGateway"
    },
    {
      "name": "Backend: Attach to User Management",
      "type": "coreclr",
      "request": "attach",
      "processName": "UserManagement"
    },
    {
      "name": "Backend: Attach to Inventory",
      "type": "coreclr",
      "request": "attach",
      "processName": "InventoryManagement"
    },
    {
      "name": "Backend: Attach to Sales",
      "type": "coreclr",
      "request": "attach",
      "processName": "SalesManagement"
    },
    {
      "name": "Backend: Attach to Financial",
      "type": "coreclr",
      "request": "attach",
      "processName": "FinancialManagement"
    },
    {
      "name": "Backend: Attach to Dashboard",
      "type": "coreclr",
      "request": "attach",
      "processName": "DashboardAnalytics"
    },

    // ============================================================
    // FRONTEND LAUNCH CONFIGURATIONS
    // ============================================================
    {
      "name": "Frontend: Launch (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: dev",
      "sourceMaps": true,
      "sourceMapPathOverrides": { "webpack:///./src/*": "${webRoot}/src/*" }
    },
    {
      "name": "Frontend: Launch (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: dev",
      "sourceMaps": true,
      "sourceMapPathOverrides": { "webpack:///./src/*": "${webRoot}/src/*" }
    },
    {
      "name": "Frontend: Attach (Chrome)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "urlFilter": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/*",
        "webpack:///*": "${webRoot}/*",
        "/./*": "${webRoot}/*",
        "/src/*": "${webRoot}/*",
        "/*": "*",
        "/./~/*": "${webRoot}/node_modules/*"
      }
    },
    {
      "name": "Frontend: Launch (Firefox)",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: dev",
      "reAttach": true,
      "pathMappings": [
        {
          "url": "http://localhost:5173",
          "path": "${workspaceFolder}/frontend"
        }
      ]
    },
    {
      "name": "Frontend: Attach (Firefox)",
      "type": "firefox",
      "request": "attach",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "pathMappings": [
        {
          "url": "http://localhost:5173",
          "path": "${workspaceFolder}/frontend"
        }
      ]
    },

    // ============================================================
    // KUBERNETES LAUNCH CONFIGURATIONS
    // ============================================================
    {
      "name": "K8s: Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "1",
      "justMyCode": false,
      "requireExactSource": false,
      "pipeTransport": {
        "pipeProgram": "kubectl",
        "pipeArgs": ["exec", "-i", "-n", "${input:k8sNamespace}", "${input:k8sPodName}", "--"],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": true
      },
      "sourceFileMap": {
        "/src/ApiGateway": "${workspaceFolder}/services/gateway/ApiGateway",
        "/src/UserManagement": "${workspaceFolder}/services/user-management/UserManagement",
        "/src/InventoryManagement": "${workspaceFolder}/services/inventory/InventoryManagement",
        "/src/SalesManagement": "${workspaceFolder}/services/sales/SalesManagement",
        "/src/FinancialManagement": "${workspaceFolder}/services/financial/FinancialManagement",
        "/src/DashboardAnalytics": "${workspaceFolder}/services/dashboard/DashboardAnalytics"
      }
    }
  ],
  "compounds": [
    {
      "name": "Backend: Launch All Services",
      "configurations": [
        "Backend: Launch Gateway",
        "Backend: Launch User Management",
        "Backend: Launch Inventory",
        "Backend: Launch Sales",
        "Backend: Launch Financial",
        "Backend: Launch Dashboard"
      ],
      "presentation": { "hidden": false, "group": "backend", "order": 1 },
      "stopAll": true
    },
    {
      "name": "Backend: Attach to All Services",
      "configurations": [
        "Backend: Attach to Gateway",
        "Backend: Attach to User Management",
        "Backend: Attach to Inventory",
        "Backend: Attach to Sales",
        "Backend: Attach to Financial",
        "Backend: Attach to Dashboard"
      ],
      "presentation": { "hidden": false, "group": "backend", "order": 2 }
    },
    {
      "name": "Full Stack: Launch All (Chrome)",
      "configurations": [
        "Backend: Launch Gateway",
        "Backend: Launch User Management",
        "Backend: Launch Inventory",
        "Backend: Launch Sales",
        "Backend: Launch Financial",
        "Backend: Launch Dashboard",
        "Frontend: Launch (Chrome)"
      ],
      "presentation": { "hidden": false, "group": "fullstack", "order": 1 },
      "stopAll": true
    },
    {
      "name": "Full Stack: Launch All (Edge)",
      "configurations": [
        "Backend: Launch Gateway",
        "Backend: Launch User Management",
        "Backend: Launch Inventory",
        "Backend: Launch Sales",
        "Backend: Launch Financial",
        "Backend: Launch Dashboard",
        "Frontend: Launch (Edge)"
      ],
      "presentation": { "hidden": false, "group": "fullstack", "order": 2 },
      "stopAll": true
    },
    {
      "name": "Full Stack: Launch All (Firefox)",
      "configurations": [
        "Backend: Launch Gateway",
        "Backend: Launch User Management",
        "Backend: Launch Inventory",
        "Backend: Launch Sales",
        "Backend: Launch Financial",
        "Backend: Launch Dashboard",
        "Frontend: Launch (Firefox)"
      ],
      "presentation": { "hidden": false, "group": "fullstack", "order": 3 },
      "stopAll": true
    }
  ]
}
