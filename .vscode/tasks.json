{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "service",
      "type": "pickString",
      "description": "Select service",
      "options": ["gateway", "user-management", "inventory", "sales", "financial", "dashboard"],
      "default": "gateway"
    },
    {
      "id": "k8sService",
      "type": "pickString",
      "description": "Select service for k8s deployment",
      "options": [
        "api-gateway",
        "user-management",
        "inventory",
        "sales",
        "financial",
        "dashboard",
        "frontend",
        "postgres",
        "kafka",
        "prometheus",
        "grafana"
      ],
      "default": "api-gateway"
    },
    {
      "id": "apiService",
      "type": "pickString",
      "description": "Select API service for client generation",
      "options": ["dashboard", "user-management", "inventory", "sales", "financial"],
      "default": "dashboard"
    },
    {
      "id": "k8sNamespace",
      "type": "promptString",
      "description": "Kubernetes namespace",
      "default": "erp-local"
    },
    {
      "id": "prodRegistry",
      "type": "promptString",
      "description": "Container registry prefix (e.g. ghcr.io/daniel)",
      "default": "ghcr.io/YOURUSER"
    },
    {
      "id": "prodTag",
      "type": "promptString",
      "description": "Image tag (e.g. latest or a git SHA)",
      "default": "latest"
    }
  ],
  "tasks": [
    // ============================================================
    // ASPIRE TASKS
    // ============================================================
    {
      "label": "aspire: stop",
      "type": "shell",
      "command": "pkill -9 dcpctrl 2>/dev/null; pkill -9 -f 'AppHost.dll' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*AppHost' 2>/dev/null; echo 'Aspire stopped'",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "aspire" }
    },
    {
      "label": "aspire: watch-apphost",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--launch-profile", "http", "--project", "${workspaceFolder}/AppHost/AppHost.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "aspire" },
      "options": {
        "cwd": "${workspaceFolder}/AppHost",
        "env": {
          "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:15227",
          "DOTNET_ENVIRONMENT": "Development"
        }
      }
    },

    // ============================================================
    // BACKEND TASKS
    // ============================================================
    {
      "label": "backend: watch-all-services",
      "dependsOn": [
        "backend: watch-gateway",
        "backend: watch-user-management",
        "backend: watch-inventory",
        "backend: watch-sales",
        "backend: watch-financial",
        "backend: watch-dashboard"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false }
    },
    {
      "label": "backend: watch-gateway",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/gateway/ApiGateway/ApiGateway.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/gateway/ApiGateway",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
      }
    },
    {
      "label": "backend: watch-user-management",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/user-management/UserManagement/UserManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/user-management/UserManagement",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
      }
    },
    {
      "label": "backend: watch-inventory",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/inventory/InventoryManagement/InventoryManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/inventory/InventoryManagement",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
      }
    },
    {
      "label": "backend: watch-sales",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/sales/SalesManagement/SalesManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/sales/SalesManagement",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
      }
    },
    {
      "label": "backend: watch-financial",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/financial/FinancialManagement/FinancialManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/financial/FinancialManagement",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
      }
    },
    {
      "label": "backend: watch-dashboard",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/dashboard/DashboardAnalytics/DashboardAnalytics.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/dashboard/DashboardAnalytics",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
      }
    },
    {
      "label": "backend: build-all-services",
      "dependsOn": [
        "backend: build-gateway",
        "backend: build-user-management",
        "backend: build-inventory",
        "backend: build-sales",
        "backend: build-financial",
        "backend: build-dashboard"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "backend: build-gateway",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/gateway/ApiGateway/ApiGateway.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-user-management",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/user-management/UserManagement/UserManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-inventory",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/inventory/InventoryManagement/InventoryManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-sales",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/sales/SalesManagement/SalesManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-financial",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/financial/FinancialManagement/FinancialManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-dashboard",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/dashboard/DashboardAnalytics/DashboardAnalytics.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: test-all",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}", "--verbosity", "minimal"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "backend: test-user-management",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/services/user-management/UserManagement.Tests/UserManagement.Tests.csproj", "--verbosity", "minimal"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "backend: test-inventory",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/services/inventory/InventoryManagement.Tests/InventoryManagement.Tests.csproj", "--verbosity", "minimal"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },

    // ============================================================
    // BACKEND API CLIENT GENERATION (Kiota)
    // ============================================================
    {
      "label": "backend: generate-all-api-clients",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/tools/ApiClientGenerator/ApiClientGenerator.csproj", "--", "--service", "all"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "group": "kiota" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "backend: generate-inventory-api-clients",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/tools/ApiClientGenerator/ApiClientGenerator.csproj", "--", "--service", "inventory"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "group": "kiota" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "backend: generate-sales-api-clients",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/tools/ApiClientGenerator/ApiClientGenerator.csproj", "--", "--service", "sales"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "group": "kiota" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "backend: generate-dashboard-api-clients",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/tools/ApiClientGenerator/ApiClientGenerator.csproj", "--", "--service", "dashboard"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "group": "kiota" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "backend: check-all-service-dependencies",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/tools/ApiClientGenerator/ApiClientGenerator.csproj", "--", "--check"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "kiota" },
      "options": { "cwd": "${workspaceFolder}" }
    },

    // ============================================================
    // FRONTEND TASKS
    // ============================================================
    {
      "label": "frontend: dev",
      "command": "npm",
      "type": "shell",
      "args": ["run", "dev"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: build",
      "command": "npm",
      "type": "shell",
      "args": ["run", "build"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: generate-all-api-clients",
      "command": "npm",
      "type": "shell",
      "args": ["run", "generate:api"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: generate-api-client",
      "command": "npm",
      "type": "shell",
      "args": ["run", "generate:api:service", "${input:apiService}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: check-services",
      "command": "npm",
      "type": "shell",
      "args": ["run", "check:services"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: use-local-gateway",
      "command": "powershell",
      "type": "shell",
      "args": ["-Command", "Copy-Item -Path '.env.local' -Destination '.env.development' -Force; Write-Host 'Frontend configured for LOCAL gateway (port 8080)'"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: use-k8s-gateway",
      "command": "powershell",
      "type": "shell",
      "args": ["-Command", "Copy-Item -Path '.env.kubernetes' -Destination '.env.development' -Force; Write-Host 'Frontend configured for K8S gateway (port 8081). Run task: k8s: port-forward-gateway'"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },

    // ============================================================
    // INFRASTRUCTURE TASKS
    // ============================================================
    {
      "label": "infra: dev-infrastructure",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "-f", "docker-compose.dev.yml", "up", "-d"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: dev-infrastructure-offline",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "-f", "docker-compose.dev.yml", "up", "-d", "--pull", "never"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: stop-dev-infrastructure",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "-f", "docker-compose.dev.yml", "down"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: docker-compose-up",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "up", "-d"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "infra: docker-compose-down",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "down"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "infra: logs",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "logs", "-f"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: mongodb-shell",
      "command": "docker",
      "type": "shell",
      "args": ["exec", "-it", "erp-mongodb", "mongosh", "-u", "admin", "-p", "admin123"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" }
    },
    {
      "label": "infra: kafka-topics-list",
      "command": "docker",
      "type": "shell",
      "args": ["exec", "erp-kafka", "kafka-topics", "--bootstrap-server", "localhost:9092", "--list"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ============================================================
    // KUBERNETES TASKS
    // ============================================================
    {
      "label": "k8s: deploy-local",
      "command": "kubectl",
      "type": "shell",
      "args": ["apply", "-k", "${workspaceFolder}/infrastructure/k8s/local/"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: delete-local",
      "command": "kubectl",
      "type": "shell",
      "args": ["delete", "namespace", "erp-local"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: get-pods",
      "command": "kubectl",
      "type": "shell",
      "args": ["get", "pods", "-n", "erp-local", "-o", "wide"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: get-services",
      "command": "kubectl",
      "type": "shell",
      "args": ["get", "services", "-n", "erp-local"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: logs-all",
      "command": "kubectl",
      "type": "shell",
      "args": ["logs", "-f", "-n", "erp-local", "--all-containers=true", "--prefix=true"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "k8s: build-images",
      "command": "powershell",
      "type": "shell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\containerd-build-images.ps1"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "k8s: port-forward-frontend",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/frontend-service", "3002:80"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: port-forward-gateway",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/gateway-service", "8081:80"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: port-forward-postgres",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/postgres-service", "5433:5432"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: port-forward-kafka",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/kafka-service", "9092:9092"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: deploy-service",
      "command": "kubectl",
      "type": "shell",
      "args": [
        "apply",
        "-f",
        "${workspaceFolder}/infrastructure/k8s/base/${input:k8sService}.yaml"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: stop-service",
      "command": "kubectl",
      "type": "shell",
      "args": [
        "delete",
        "-f",
        "${workspaceFolder}/infrastructure/k8s/base/${input:k8sService}.yaml",
        "--ignore-not-found"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: restart",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "${input:k8sNamespace}", "rollout", "restart", "deployment/${input:service}"],
      "problemMatcher": []
    },
    {
      "label": "k8s: get-pod-name",
      "command": "powershell",
      "type": "shell",
      "args": [
        "-NoProfile",
        "-Command",
        "$pod = kubectl -n ${input:k8sNamespace} get pods -l app=${input:service} -o jsonpath='{.items[0].metadata.name}'; $pod; Set-Clipboard -Value $pod; Write-Host ''; Write-Host 'Copied pod name to clipboard.'; Write-Host 'Use in: Run and Debug -> K8s: Attach'"
      ],
      "problemMatcher": []
    },

    // ============================================================
    // PRODUCTION / K3S TASKS  (server: ${K3S_SERVER})
    // ============================================================
    {
      // One-time: installs cert-manager on the k3s cluster and creates
      // Let's Encrypt ClusterIssuers (prod + staging) for shopping-now.net.
      // Run before 'prod: deploy' when setting up TLS for the first time.
      // Requires: KUBECONFIG=~/.kube/k3s-erp.yaml (set by prod: setup-server)
      "label": "prod: install-cert-manager",
      "type": "shell",
      "command": "KUBECONFIG=~/.kube/k3s-erp.yaml bash infrastructure/cert-manager/install.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "prod" }
    },
    {
      // One-time: copies the k3s kubeconfig to ~/.kube/k3s-erp.yaml so
      // that kubectl can talk to the remote cluster from your Mac.
      "label": "prod: setup-server",
      "type": "shell",
      "command": "bash scripts/k3s-setup-server.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "prod" }
    },
    {
      // Builds all Docker images for linux/amd64 and pushes them to the registry.
      // Prompts for REGISTRY (e.g. ghcr.io/daniel) and TAG (e.g. latest).
      "label": "prod: build-push",
      "type": "shell",
      "command": "bash scripts/k3s-build-push.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "REGISTRY": "${input:prodRegistry}",
          "TAG": "${input:prodTag}"
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "prod" }
    },
    {
      // Deploys the already-pushed images to the k3s server via kubectl.
      // Uses ~/.kube/k3s-erp.yaml – run 'prod: setup-server' first if missing.
      "label": "prod: deploy",
      "type": "shell",
      "command": "bash scripts/k3s-deploy.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "REGISTRY": "${input:prodRegistry}",
          "TAG": "${input:prodTag}"
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "prod" }
    },
    {
      // Convenience: build + push + deploy in one go.
      // Both steps share the same REGISTRY/TAG prompt answers.
      "label": "prod: build-push-deploy",
      "type": "shell",
      "command": "bash scripts/k3s-build-push.sh && bash scripts/k3s-deploy.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "REGISTRY": "${input:prodRegistry}",
          "TAG": "${input:prodTag}"
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "prod" }
    },
    {
      // Show all pod statuses in the production namespace.
      "label": "prod: status",
      "type": "shell",
      "command": "KUBECONFIG=~/.kube/k3s-erp.yaml kubectl get pods,ingress,svc -n erp-prod -o wide",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "prod" }
    },
    {
      // Stream logs for a specific service in production.
      "label": "prod: logs",
      "type": "shell",
      "command": "KUBECONFIG=~/.kube/k3s-erp.yaml kubectl logs -n erp-prod -f deploy/${input:service}",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "prod" }
    },
    {
      // Force-restart a deployment in production (re-pulls the image).
      "label": "prod: rollout-restart",
      "type": "shell",
      "command": "KUBECONFIG=~/.kube/k3s-erp.yaml kubectl rollout restart deploy/${input:service} -n erp-prod",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "prod" }
    },

    // ============================================================
    // MAIN COMPOSITE TASKS
    // ============================================================
    {
      "label": "dev-setup",
      "dependsOn": [
        "infra: dev-infrastructure",
        "backend: watch-all-services",
        "frontend: dev"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    }
  ]
}
