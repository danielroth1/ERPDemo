{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "service",
      "type": "pickString",
      "description": "Select service",
      "options": ["gateway", "user-management", "inventory", "sales", "financial", "dashboard"],
      "default": "gateway"
    },
    {
      "id": "k8sService",
      "type": "pickString",
      "description": "Select service for k8s deployment",
      "options": [
        "api-gateway",
        "user-management",
        "inventory",
        "sales",
        "financial",
        "dashboard",
        "frontend",
        "postgres",
        "kafka",
        "prometheus",
        "grafana"
      ],
      "default": "api-gateway"
    },
    {
      "id": "apiService",
      "type": "pickString",
      "description": "Select API service for client generation",
      "options": ["dashboard", "user-management", "inventory", "sales", "financial", "orchestration"],
      "default": "dashboard"
    },
    {
      "id": "backendConsumerService",
      "type": "pickString",
      "description": "Backend consumer service whose Kiota clients should be updated",
      "options": ["inventory", "sales", "dashboard"],
      "default": "inventory"
    },
    {
      "id": "k8sNamespace",
      "type": "promptString",
      "description": "Kubernetes namespace",
      "default": "erp-local"
    },
    {
      "id": "prodRegistry",
      "type": "promptString",
      "description": "Container registry prefix (e.g. ghcr.io/daniel)",
      "default": "ghcr.io/YOURUSER"
    },
    {
      "id": "prodTag",
      "type": "promptString",
      "description": "Image tag (e.g. latest or a git SHA)",
      "default": "latest"
    }
  ],
  "tasks": [
    // ============================================================
    // ASPIRE TASKS
    // ============================================================
    {
      "label": "aspire: stop",
      "type": "shell",
      "command": "pkill -9 dcpctrl 2>/dev/null; pkill -9 -f 'AppHost.dll' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*AppHost' 2>/dev/null; echo 'Aspire stopped'",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "aspire" }
    },
    {
      "label": "aspire: watch-apphost",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--launch-profile", "http", "--project", "${workspaceFolder}/AppHost/AppHost.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "aspire" },
      "options": {
        "cwd": "${workspaceFolder}/AppHost",
        "env": {
          "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:15227",
          "DOTNET_ENVIRONMENT": "Development"
        }
      }
    },

    // ============================================================
    // BACKEND TASKS
    // ============================================================
    {
      "label": "backend: stop-all-services",
      "type": "shell",
      "command": "pkill -9 -f 'dotnet.*watch.*ApiGateway' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*UserManagement' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*InventoryManagement' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*SalesManagement' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*FinancialManagement' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*DashboardAnalytics' 2>/dev/null; pkill -9 -f 'dotnet.*watch.*Orchestration' 2>/dev/null; echo 'All backend services stopped'",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" }
    },
    {
      "label": "backend: restart-all-services",
      "dependsOrder": "sequence",
      "dependsOn": ["backend: stop-all-services", "backend: watch-all-services"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" }
    },
    {
      "label": "backend: watch-all-services",
      "dependsOn": [
        "backend: watch-gateway",
        "backend: watch-user-management",
        "backend: watch-inventory",
        "backend: watch-sales",
        "backend: watch-financial",
        "backend: watch-dashboard",
        "backend: watch-orchestration"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false }
    },
    {
      "label": "backend: watch-gateway",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/gateway/ApiGateway/ApiGateway.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/gateway/ApiGateway",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4319",
          "OTEL_SERVICE_NAME": "gateway"
        }
      }
    },
    {
      "label": "backend: watch-user-management",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/user-management/UserManagement/UserManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/user-management/UserManagement",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4319",
          "OTEL_SERVICE_NAME": "user-management"
        }
      }
    },
    {
      "label": "backend: watch-inventory",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/inventory/InventoryManagement/InventoryManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/inventory/InventoryManagement",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4319",
          "OTEL_SERVICE_NAME": "inventory"
        }
      }
    },
    {
      "label": "backend: watch-sales",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/sales/SalesManagement/SalesManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/sales/SalesManagement",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4319",
          "OTEL_SERVICE_NAME": "sales"
        }
      }
    },
    {
      "label": "backend: watch-financial",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/financial/FinancialManagement/FinancialManagement.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/financial/FinancialManagement",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4319",
          "OTEL_SERVICE_NAME": "financial"
        }
      }
    },
    {
      "label": "backend: watch-dashboard",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/dashboard/DashboardAnalytics/DashboardAnalytics.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/dashboard/DashboardAnalytics",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4319",
          "OTEL_SERVICE_NAME": "dashboard"
        }
      }
    },
    {
      "label": "backend: watch-orchestration",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/services/orchestration/Orchestration/Orchestration.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "backend" },
      "options": {
        "cwd": "${workspaceFolder}/services/orchestration/Orchestration",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4319",
          "OTEL_SERVICE_NAME": "orchestration"
        }
      }
    },
    {
      "label": "backend: build-all-services",
      "dependsOn": [
        "backend: build-gateway",
        "backend: build-user-management",
        "backend: build-inventory",
        "backend: build-sales",
        "backend: build-financial",
        "backend: build-dashboard"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "backend: build-gateway",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/gateway/ApiGateway/ApiGateway.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-user-management",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/user-management/UserManagement/UserManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-inventory",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/inventory/InventoryManagement/InventoryManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-sales",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/sales/SalesManagement/SalesManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-financial",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/financial/FinancialManagement/FinancialManagement.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: build-dashboard",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/services/dashboard/DashboardAnalytics/DashboardAnalytics.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: test-all",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}", "--verbosity", "minimal"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "backend: test-user-management",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/services/user-management/UserManagement.Tests/UserManagement.Tests.csproj", "--verbosity", "minimal"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "backend: test-inventory",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/services/inventory/InventoryManagement.Tests/InventoryManagement.Tests.csproj", "--verbosity", "minimal"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },

    // ============================================================
    // BACKEND API CLIENT GENERATION (Kiota)
    // Exports OpenAPI specs from running services, then regenerates
    // Kiota C# clients — no running services needed for generation.
    // ============================================================
    {
      // Export specs + regenerate Kiota clients for ALL consumer services.
      // Requires the backend services that provide APIs to be running.
      "label": "backend: update-all-api-clients",
      "command": "node",
      "type": "shell",
      "args": ["${workspaceFolder}/scripts/update-api-clients.mjs"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "group": "kiota" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      // Export specs + regenerate Kiota clients for a SINGLE consumer service.
      // Prompts to pick: inventory | sales | dashboard
      "label": "backend: update-api-clients",
      "command": "node",
      "type": "shell",
      "args": ["${workspaceFolder}/scripts/update-api-clients.mjs", "--service", "${input:backendConsumerService}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "group": "kiota" },
      "options": { "cwd": "${workspaceFolder}" }
    },

    // ============================================================
    // FRONTEND TASKS
    // ============================================================
    {
      "label": "frontend: dev",
      "command": "npm",
      "type": "shell",
      "args": ["run", "dev"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: build",
      "command": "npm",
      "type": "shell",
      "args": ["run", "build"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: lint",
      "command": "npm",
      "type": "shell",
      "args": ["run", "lint"],
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "shared", "focus": true },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": { "kind": "test", "isDefault": false }
    },
    {
      "label": "frontend: generate-all-api-clients",
      "command": "npm",
      "type": "shell",
      "args": ["run", "generate:api"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: generate-api-client",
      "command": "npm",
      "type": "shell",
      "args": ["run", "generate:api:service", "${input:apiService}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: check-services",
      "command": "npm",
      "type": "shell",
      "args": ["run", "check:services"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: use-local-gateway",
      "command": "powershell",
      "type": "shell",
      "args": ["-Command", "Copy-Item -Path '.env.local' -Destination '.env.development' -Force; Write-Host 'Frontend configured for LOCAL gateway (port 8080)'"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: use-k8s-gateway",
      "command": "powershell",
      "type": "shell",
      "args": ["-Command", "Copy-Item -Path '.env.kubernetes' -Destination '.env.development' -Force; Write-Host 'Frontend configured for K8S gateway (port 8081). Run task: k8s: port-forward-gateway'"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },

    // ============================================================
    // FRONTEND TEST TASKS
    // ============================================================
    {
      "label": "frontend: test",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "frontend" }
    },
    {
      "label": "frontend: test:watch",
      "type": "shell",
      "command": "npm run test:watch",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "frontend" }
    },
    {
      "label": "frontend: test:coverage",
      "type": "shell",
      "command": "npm run test:coverage",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "frontend" }
    },

    // ============================================================
    // E2E TEST TASKS
    // ============================================================
    {
      "label": "e2e: test",
      "type": "shell",
      "command": "npx playwright test --project=chromium",
      "options": { "cwd": "${workspaceFolder}/tests/e2e" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "e2e" }
    },
    {
      "label": "e2e: test:all-browsers",
      "type": "shell",
      "command": "npx playwright test",
      "options": { "cwd": "${workspaceFolder}/tests/e2e" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "e2e" }
    },
    {
      "label": "e2e: test:ui",
      "type": "shell",
      "command": "npx playwright test --ui",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}/tests/e2e" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "e2e" }
    },
    {
      "label": "e2e: install-browsers",
      "type": "shell",
      "command": "npx playwright install --with-deps chromium firefox webkit",
      "options": { "cwd": "${workspaceFolder}/tests/e2e" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "e2e" }
    },

    // ============================================================
    // INFRASTRUCTURE TASKS
    // ============================================================
    {
      "label": "infra: dev-infrastructure",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "-f", "docker-compose.dev.yml", "up", "-d"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: dev-infrastructure-offline",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "-f", "docker-compose.dev.yml", "up", "-d", "--pull", "never"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: stop-dev-infrastructure",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "-f", "docker-compose.dev.yml", "down"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: docker-compose-up",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "up", "-d"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "infra: docker-compose-down",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "down"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "infra: logs",
      "command": "docker",
      "type": "shell",
      "args": ["compose", "logs", "-f"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" },
      "options": { "cwd": "${workspaceFolder}/infrastructure" }
    },
    {
      "label": "infra: mongodb-shell",
      "command": "docker",
      "type": "shell",
      "args": ["exec", "-it", "erp-mongodb", "mongosh", "-u", "admin", "-p", "admin123"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "infrastructure" }
    },
    {
      "label": "infra: kafka-topics-list",
      "command": "docker",
      "type": "shell",
      "args": ["exec", "erp-kafka", "kafka-topics", "--bootstrap-server", "localhost:9092", "--list"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ============================================================
    // KUBERNETES TASKS
    // ============================================================
    {
      "label": "k8s: deploy-local",
      "command": "kubectl",
      "type": "shell",
      "args": ["apply", "-k", "${workspaceFolder}/infrastructure/k8s/local/"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: delete-local",
      "command": "kubectl",
      "type": "shell",
      "args": ["delete", "namespace", "erp-local"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: get-pods",
      "command": "kubectl",
      "type": "shell",
      "args": ["get", "pods", "-n", "erp-local", "-o", "wide"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: get-services",
      "command": "kubectl",
      "type": "shell",
      "args": ["get", "services", "-n", "erp-local"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "k8s: logs-all",
      "command": "kubectl",
      "type": "shell",
      "args": ["logs", "-f", "-n", "erp-local", "--all-containers=true", "--prefix=true"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "k8s: build-images",
      "command": "bash",
      "type": "shell",
      "args": ["${workspaceFolder}/scripts/k3s-build-local.sh"],
      // "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\containerd-build-images.ps1"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "k8s: port-forward-frontend",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/frontend-service", "3002:80"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: port-forward-gateway",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/gateway-service", "8081:80"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: port-forward-postgres",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/postgres-service", "5433:5432"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: port-forward-kafka",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/kafka-service", "9092:9092"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: port-forward-pgadmin",
      "command": "kubectl",
      "type": "shell",
      "args": ["-n", "erp-local", "port-forward", "svc/pgadmin-service", "5051:5050"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "port-forward" }
    },
    {
      "label": "k8s: deploy-service",
      "command": "kubectl",
      "type": "shell",
      "args": [
        "apply",
        "-f",
        "${workspaceFolder}/infrastructure/k8s/base/${input:k8sService}.yaml"
      ],
      "problemMatcher": [],
