# =============================================================================
# .env.deploy.example
# Copy this file to .env.deploy and fill in your values.
#   cp .env.deploy.example .env.deploy
#
# .env.deploy is git-ignored and never committed.
# It is sourced automatically by deploy.sh, k3s-build-push.sh,
# k3s-deploy.sh, k3s-setup-server.sh, and cert-manager/install.sh.
# =============================================================================

# ── Legacy docker-compose deployment (deploy.sh) ──────────────────────────────
DEPLOY_SERVER="user@your-server-hostname"
DEPLOY_REMOTE_DIR="/home/user/ERPDemo"
DEPLOY_LOCAL_DIR="/path/to/local/ERPDemo"

# ── k3s / Kubernetes deployment ───────────────────────────────────────────────
K3S_SERVER="user@your-k3s-server-ip"
K3S_SSH_PORT="22"

# ── Container registry ────────────────────────────────────────────────────────
# Used by k3s-build-push.sh and k3s-deploy.sh
# REGISTRY can also be overridden at runtime: REGISTRY=ghcr.io/other ./k3s-deploy.sh
REGISTRY="ghcr.io/YOURUSER"

# GitHub username — must match the registry owner (used for image pull secrets)
YOURUSER="YOURUSER"

# ── cert-manager / Let's Encrypt ──────────────────────────────────────────────
ACME_EMAIL="your-email@example.com"
DOMAIN="your-domain.com"

# ── Grafana ───────────────────────────────────────────────────────────────────
# Admin password for Grafana (monitoring.your-domain.com)
GRAFANA_ADMIN_PASSWORD="your-grafana-password"

# ── pgAdmin (PostgreSQL Web UI) ────────────────────────────────────────────────
# Login credentials for pgAdmin when deployed to Kubernetes
PGADMIN_DEFAULT_EMAIL="admin@erp.local"
PGADMIN_DEFAULT_PASSWORD="your-pgadmin-password"
PGADMIN_CONFIG_CHECK_EMAIL_DELIVERABILITY="False"
PGADMIN_CONFIG_ALLOW_SPECIAL_EMAIL_DOMAINS="['local']"
