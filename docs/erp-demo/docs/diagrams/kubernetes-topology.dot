digraph k8s_topology {
  rankdir=TB;
  graph [nodesep=0.7, ranksep=0.95, pad=0.2, splines=polyline, concentrate=true];
  node [shape=box, style="rounded", fontsize=11];
  edge [penwidth=1];

  user [label="Developer / Browser"];
  ingress [label="Traefik / Gateway API"];
  gateway [label="API Gateway pods"];

  inventory [label="Inventory pods"];
  sales [label="Sales pods"];
  financial [label="Financial pods"];
  dashboard [label="Dashboard pods"];
  orchestration [label="Orchestration pods"];
  users [label="User Management pods"];

  postgres [label="PostgreSQL\nor Azure Database", shape=cylinder];
  kafka [label="Kafka", shape=component];
  rabbit [label="RabbitMQ", shape=component];
  minio [label="MinIO", shape=cylinder];
  grafana [label="Grafana / Loki / Tempo / Prometheus", shape=folder];

  user -> ingress -> gateway;
  gateway -> inventory [sametail=gw];
  gateway -> sales [sametail=gw];
  gateway -> financial [sametail=gw];
  gateway -> dashboard [sametail=gw];
  gateway -> orchestration [sametail=gw];
  gateway -> users [sametail=gw];

  inventory -> postgres [samehead=pg];
  sales -> postgres [samehead=pg];
  financial -> postgres [samehead=pg];
  dashboard -> postgres [samehead=pg];
  orchestration -> postgres [samehead=pg];
  users -> postgres [samehead=pg];

  inventory -> minio;
  inventory -> kafka [samehead=events];
  sales -> kafka [samehead=events];
  financial -> kafka [samehead=events];
  dashboard -> kafka [samehead=events];
  orchestration -> kafka [samehead=events];
  orchestration -> rabbit [samehead=commands];
  inventory -> rabbit [samehead=commands];
  financial -> rabbit [samehead=commands];

  gateway -> grafana [style=dashed, samehead=telemetry];
  inventory -> grafana [style=dashed, samehead=telemetry];
  sales -> grafana [style=dashed, samehead=telemetry];
  financial -> grafana [style=dashed, samehead=telemetry];
  dashboard -> grafana [style=dashed, samehead=telemetry];
  orchestration -> grafana [style=dashed, samehead=telemetry];
  users -> grafana [style=dashed, samehead=telemetry];
}