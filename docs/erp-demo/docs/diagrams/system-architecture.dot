digraph architecture {
  rankdir=LR;
  graph [nodesep=0.65, ranksep=1.05, pad=0.2, splines=polyline, concentrate=true];
  node [shape=box, style="rounded", fontsize=11];
  edge [penwidth=1];

  browser [label="Browser\nReact SPA"];
  gateway [label="API Gateway\nYARP + Auth + Rate limiting"];

  users [label="User Management"];
  inventory [label="Inventory"];
  sales [label="Sales"];
  financial [label="Financial"];
  dashboard [label="Dashboard"];
  orchestration [label="Orchestration"];

  postgres [label="PostgreSQL\nservice databases", shape=cylinder];
  kafka [label="Kafka\ndomain events", shape=component];
  rabbit [label="RabbitMQ\nworkflow commands", shape=component];
  redis [label="Redis", shape=cylinder];
  minio [label="MinIO\nS3-compatible storage", shape=cylinder];
  obs [label="Grafana / Prometheus / Loki / Tempo", shape=folder];

  browser -> gateway;

  gateway -> users [sametail=gw];
  gateway -> inventory [sametail=gw];
  gateway -> sales [sametail=gw];
  gateway -> financial [sametail=gw];
  gateway -> dashboard [sametail=gw];
  gateway -> orchestration [sametail=gw];

  users -> postgres [samehead=pg];
  inventory -> postgres [samehead=pg];
  sales -> postgres [samehead=pg];
  financial -> postgres [samehead=pg];
  dashboard -> postgres [samehead=pg];
  orchestration -> postgres [samehead=pg];

  inventory -> minio;
  dashboard -> redis;

  users -> kafka [samehead=events];
  inventory -> kafka [samehead=events];
  sales -> kafka [samehead=events];
  financial -> kafka [samehead=events];
  orchestration -> kafka [samehead=events];
  dashboard -> kafka [samehead=events];

  orchestration -> rabbit [samehead=commands];
  inventory -> rabbit [samehead=commands];
  financial -> rabbit [samehead=commands];

  gateway -> obs [style=dashed, samehead=telemetry];
  users -> obs [style=dashed, samehead=telemetry];
  inventory -> obs [style=dashed, samehead=telemetry];
  sales -> obs [style=dashed, samehead=telemetry];
  financial -> obs [style=dashed, samehead=telemetry];
  dashboard -> obs [style=dashed, samehead=telemetry];
  orchestration -> obs [style=dashed, samehead=telemetry];
}