digraph observability_flow {
  rankdir=LR;
  graph [nodesep=0.55, ranksep=1.3, pad=0.35, splines=polyline, concentrate=false,
         fontname="sans-serif"];
  node  [shape=box, style="rounded,filled", fontsize=10, fontname="sans-serif"];
  edge  [fontsize=9,  fontname="sans-serif", penwidth=1.2];

  // ── .NET Services ─────────────────────────────────────────────────────────
  services [
    label="7 ASP.NET Core Services\nGateway :8080  ·  User Management :5001\nInventory :5002  ·  Sales :5003\nFinancial :5004  ·  Dashboard :5005  ·  Orchestration :5010",
    fillcolor="#c5d8ff"
  ];

  kafka_jmx [
    label="Kafka JMX Exporter\n:7071",
    shape=component, fillcolor="#ffe0b2", fontsize=9
  ];

  docker_sock [
    label="Docker socket\n/var/run/docker.sock",
    shape=cylinder, fillcolor="#e0e0e0", fontsize=9
  ];

  // ── Collection ────────────────────────────────────────────────────────────
  subgraph cluster_collection {
    label="Collection";
    style=dashed; color="#b58a00"; bgcolor="#fffde7"; fontsize=10;
    node [fillcolor="#fff9c4"];

    prometheus [label="Prometheus v2.48.0\n:9090"];
    alloy      [label="Grafana Alloy\n:4319  OTLP gRPC\n:12345  Alloy UI"];
  }

  // ── Storage ───────────────────────────────────────────────────────────────
  subgraph cluster_storage {
    label="Storage";
    style=dashed; color="#388e3c"; bgcolor="#e8f5e9"; fontsize=10;
    node [fillcolor="#c8e6c9"];

    loki  [label="Loki 3.4.1\n:3100  —  7-day retention"];
    tempo [label="Tempo 2.3.1\n:3200 HTTP API\n:4317 OTLP gRPC\n:4318 OTLP HTTP"];
  }

  // ── Visualisation ─────────────────────────────────────────────────────────
  grafana [
    label="Grafana 10.2.0\n:3001\n3 provisioned dashboards",
    fillcolor="#ce93d8"
  ];

  // ── Signal 1: Metrics (blue) — Prometheus pull ────────────────────────────
  services   -> prometheus [label="HTTP pull /metrics\n(every 15 s)",
                            color="#1565c0", fontcolor="#1565c0"];
  kafka_jmx  -> prometheus [label="HTTP pull :7071",
                            color="#1565c0", fontcolor="#1565c0", style=dashed];

  // ── Signal 2: Logs (green) ────────────────────────────────────────────────
  // Docker mode  : Alloy discovers container stdout via Docker socket
  // Host dev     : services emit OTLP logs to Alloy :4319
  docker_sock -> alloy [label="container log\ndiscovery",
                        color="#2e7d32", fontcolor="#2e7d32"];
  services    -> alloy [label="OTLP logs :4319\n(host dev mode)",
                        color="#2e7d32", fontcolor="#2e7d32", style=dashed];
  alloy       -> loki  [label="push (Loki API)",
                        color="#2e7d32", fontcolor="#2e7d32"];

  // ── Signal 3: Traces (orange) ─────────────────────────────────────────────
  // Docker mode  : services push OTLP directly to Tempo :4317
  // Host dev     : services push to Alloy :4319, which relays to Tempo
  services -> tempo [label="OTLP gRPC :4317\n(Docker mode)",
                     color="#e65100", fontcolor="#e65100"];
  services -> alloy [label="OTLP traces :4319\n(host dev mode)",
                     color="#e65100", fontcolor="#e65100", style=dashed];
  alloy    -> tempo [label="forward traces",
                     color="#e65100", fontcolor="#e65100"];

  // ── Derived metrics: Tempo → Prometheus (purple dashed) ───────────────────
  // metrics_generator processors: service-graphs + span-metrics
  tempo -> prometheus [label="remote-write\nspan-metrics · service-graphs",
                       color="#6a1b9a", fontcolor="#6a1b9a", style=dashed];

  // ── Grafana queries ───────────────────────────────────────────────────────
  grafana -> prometheus [label="PromQL",   color="#1565c0", fontcolor="#1565c0"];
  grafana -> loki       [label="LogQL",    color="#2e7d32", fontcolor="#2e7d32"];
  grafana -> tempo      [label="TraceQL",  color="#e65100", fontcolor="#e65100"];
}
