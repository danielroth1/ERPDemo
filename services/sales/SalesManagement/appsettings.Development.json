{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PostgreSQL": {
    "ConnectionString": "Host=localhost;Port=5433;Database=erp_sales;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "local-development-secret-key-min-32-characters-long-not-for-production"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "sales-events"
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [{ "key": "service", "value": "sales" }]
        }
      }
    ]
  }
}
