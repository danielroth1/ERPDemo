{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PostgreSQL": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "erp-system",
    "Audience": "erp-clients"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "Topic": "inventory-events"
  },
  "RabbitMQ": {
    "Host": "rabbitmq"
  },
  "Services": {
    "Financial": "http://financial:8080"
  },
  "Minio": {
    "Endpoint": "localhost:9002",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSSL": false,
    "ImagesBucket": "erp-item-images",
    "DocumentsBucket": "erp-item-documents",
    "PublicEndpoint": "http://localhost:9002"
  },
  "Financial": {
    "RevenueAccountId": "REVENUE_ACCOUNT"
  },
  "DefaultAccounts": {
    "RevenueAccountNumber": "4000-REVENUE"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
