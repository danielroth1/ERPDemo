## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Kiota Generated Files - exclude generated C# code but keep lock files
Generated/**/*.cs
Generated/**/*.kiota.log
*.kiota.log

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Others
*.log
*.cache
*.dll
*.exe
*.pdb
