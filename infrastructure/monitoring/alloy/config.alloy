// Grafana Alloy configuration for local Docker Compose development
// Collects logs from all Docker containers and forwards them to Loki.
// Host-running .NET services (dotnet watch) send OTLP to Alloy on port 4319,
// which routes: logs → Loki, traces → Tempo.

// ──────────────────────────────────────────────────────────────────────────────
// Docker container log collection
// ──────────────────────────────────────────────────────────────────────────────

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Relabel discovered Docker containers to extract useful labels
discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets

  // Use the container name as the "container" label (strip leading slash)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  // Use the "com.docker.compose.service" label as the "service" label
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Propagate the image name
  rule {
    source_labels = ["__meta_docker_container_image_name"]
    target_label  = "image"
  }
}

loki.source.docker "docker_logs" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.docker_labels.output

  forward_to = [loki.write.local.receiver]

  relabel_rules = discovery.relabel.docker_labels.rules
}

// ──────────────────────────────────────────────────────────────────────────────
// Loki write endpoint
// ──────────────────────────────────────────────────────────────────────────────

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ──────────────────────────────────────────────────────────────────────────────
// OTLP receiver for host-running .NET services (dotnet watch / non-Docker dev)
// Services set OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319 (gRPC).
// Logs are converted to Loki format; traces are forwarded to Tempo.
// ──────────────────────────────────────────────────────────────────────────────

otelcol.receiver.otlp "host_services" {
  grpc {
    endpoint = "0.0.0.0:4319"
  }

  output {
    logs   = [otelcol.exporter.loki.default.input]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.local.receiver]
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
