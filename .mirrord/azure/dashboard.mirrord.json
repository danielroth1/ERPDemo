{
  "agent": {
    "ephemeral": true
  },
  "key": "REPLACE_ME",
  "kubeconfig": "~/.kube/aks-erp.yaml",
  "target": {
    "path": "deployment/dashboard",
    "namespace": "erp-azure"
  },
  "feature": {
    "env": {
      "override": {
        "ASPNETCORE_URLS": "http://localhost:5005",
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "dashboard-local-{{ key }}"
      }
    },
    "network": {
      "incoming": {
        "mode": "steal",
        "http_filter": {
          "header_filter": "^x-mirrord-session: {{ key }}$"
        },
        "port_mapping": [
          [
            5005,
            8080
          ]
        ]
      }
    },
    "fs": {
      "mode": "local"
    }
  }
}